# ========================================================
# CONFIGURACIÓN DE PRODUCCIÓN - SENAE CONTROL PREVIO v2.0
# Copiar este archivo como .env.production y definir valores
# ========================================================

# Puerto local del servicio
APP_PORT=3000
APP_URL=https://controlprevio.aduana.gob.ec

# Credenciales de PostgreSQL 16
POSTGRES_USER=senae_admin
POSTGRES_PASSWORD=CAMBIAR_POR_CLAVE_SEGURA_MINIMO_16_CARACTERES
POSTGRES_DB=senae_control_previo

# Cadena de conexión JDBC / Prisma
DATABASE_URL=postgresql://senae_admin:CAMBIAR_POR_CLAVE_SEGURA_MINIMO_16_CARACTERES@localhost:5432/senae_control_previo?schema=public

# Secretos criptográficos (Generar con: openssl rand -hex 32)
CAPTCHA_SECRET=CAMBIAR_POR_CLAVE_ALEATORIA_CAPTCHA_64_HEX
AUTH_SECRET=CAMBIAR_POR_CLAVE_ALEATORIA_AUTH_64_HEX
